{
  "name": "8sian-pos",
  "version": "0.3.0",
  "private": true,
  "description": "8 Sian Windows POS",
  "author": "8 Sian",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "npm run start",
    "start": "electron .",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "test": "node --test tests/*.test.cjs",
    "check:render": "electron scripts/check-render.cjs",
    "check:hardware-ui": "electron scripts/check-hardware-ui.cjs"
  },
  "dependencies": {
    "jsbarcode": "^3.12.3"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.8sian.pos",
    "productName": "8 Sian POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "web/receipt.js",
      "web/shift-receipt.js",
      "web/style.css",
      "web/images/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "desktop/bluetooth.ps1"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
